# PFR Recovery Advisor – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit a populated .env to source control.

# -----------------------------------------------------------------------
# Azure OpenAI (required for Stage B LLM explainer in production)
# -----------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -----------------------------------------------------------------------
# Azure AI Search (required for cloud-scale retrieval)
# -----------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-key>
AZURE_SEARCH_INDEX_NAME=pfr-knowledge

# -----------------------------------------------------------------------
# Feature flags (set to true to switch from local stubs to Azure)
# -----------------------------------------------------------------------
USE_AZURE_OPENAI=false
USE_AZURE_SEARCH=false

# -----------------------------------------------------------------------
# Local paths (defaults work for local dev – override if needed)
# -----------------------------------------------------------------------
DATA_DIR=data
DOCS_DIR=data/sample_docs
DEPENDENCIES_FILE=data/dependencies.json
INGEST_STORE=data/ingested_docs.jsonl
